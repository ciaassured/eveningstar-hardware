	(text "74HC14 datasheet specifically allows for use of current limiting resistors\n+ inbuilt input clamp diodes to interface input voltage in excess of VCC.\n- Note that this does inject some current onto the VCC rail."
		(exclude_from_sim no)
		(at 147.574 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "36c242f1-61ef-4045-a7a5-fa40244e8632")
	)
	(text "Bus Transmitter"
		(exclude_from_sim no)
		(at 139.446 73.152 0)
		(effects
